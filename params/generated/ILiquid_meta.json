m. `amount` is then deducted from the caller's allowance. Returns a boolean value indicating whether the operation succeeded. Emits a {Transfer} event."}},"version":1},"userdoc":{"events":{"UnbondingApproval(address,address,uint256)":{"notice":"Emitted when the unbond-allowance (LNTN) of a `_caller` for an `_owner` is set by a call to `approveUnbonding`. `_value` is the new unbond-allowance (LNTN)."}},"kind":"user","methods":{"approveUnbonding(address,uint256)":{"notice":"Sets `_amount` as the unbond-allowance (LNTN) of `_caller` over the caller's tokens. Returns a boolean value indicating whether the operation succeeded. Emits an {UnbondingApproval} event."},"burn(address,uint256)":{"notice":"Burn LNTN when they are unbonded."},"claimRewards()":{"notice":"Claim accrued atn rewards."},"claimTreasuryATN()":{"notice":"Claim the unclaimed atn rewards by the treasury."},"getCommissionRate()":{"notice":"Returns the commission rate of the validator."},"getTreasuryUnclaimedATN()":{"notice":"Amount of unclaimed atn rewards by the treasury."},"lock(address,uint256)":{"notice":"Lock LNTN to unbond at the epoch end."},"lockFrom(address,address,uint256)":{"notice":"Lock LNTN from `_account` to unbond at the epoch end. `_caller` is the caller and must have enough `unbondingAllowance`."},"lockedBalanceOf(address)":{"notice":"Amount of LNTN locked to be unbonded."},"mint(address,uint256)":{"notice":"Issue new LNTN when some NTN are bonded."},"redistribute(uint256)":{"notice":"Distribute the atn rewards among delegators and auto-bond the ntn rewards proportional to their balances"},"setCommissionRate(uint256)":{"notice":"Change validator commission rate."},"unbondingAllowance(address,address)":{"notice":"Returns the remaining number of LNTN that `_caller` will be allowed to unbond on behalf of `_owner` through `unbondFrom`. This is zero by default."},"unclaimedRewards(address)":{"notice":"Amount of atn rewards yet to be claimed"},"unlock(address,uint256)":{"notice":"Unlock the locked LNTN"},"unlockedBalanceOf(address)":{"notice":"Amount of unlocked LNTN."}},"version":1}},"settings":{"compilationTarget":{"autonity/solidity/contracts/interfaces/ILiquid.sol":"ILiquid"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":10000},"remappings":[]},"sources":{"autonity/solidity/contracts/interfaces/IERC20.sol":{"keccak256":"0x25d21d6798e039ebe4199b1db0da58c243d0696c2891ec7f22b9500f34ec6c8a","license":"LGPL-3.0-only","urls":["bzz-raw://0b435b7b2f6ad6c45009c7deb1822f1e28a875cac2de71b027f21d44726d0406","dweb:/ipfs/QmYfRNtZP857A8K6qsyqyS6tw3sGL4LA84GP9cQ48JZRWt"]},"autonity/solidity/contracts/interfaces/ILiquid.sol":{"keccak256":"0x24086bb6b2b9900a37c2a6307b9e9dfd4e3a766d6e27487f3fe3879e941e4239","license":"LGPL-3.0-only","urls":["bzz-raw://ca6eb20d8c417a9204aeba9a4d98fafe4d1debd6ee55aa572d31438bdb1ed5a9","dweb:/ipfs/Qmdc2MQkadkDGQhN6xfUj1ykXQc1KN7o5gWtG8nvFZtd69"]}},"version":1}