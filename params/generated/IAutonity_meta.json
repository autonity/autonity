,address)":{"params":{"addr":"node address of the validator.","enode":"enode of validator","liquidStateContract":"liquidStateContract address","oracleAddress":"address of the oracle node run by validator","treasury":"treasury account"}},"Rewarded(address,uint256,uint256,uint256,uint256)":{"params":{"addr":"node address of validator","atnDelegatedAmount":"delegator's atn rewards (includes validator commission)","atnSelfAmount":"validator's atn rewards","ntnDelegatedAmount":"delegator's ntn rewards (includes validator commission)","ntnSelfAmount":"validator's ntn rewards"}},"Transfer(address,address,uint256)":{"details":"Emitted when `value` tokens are moved from one account (`from`) to another (`to`). Note that `value` may be zero."}},"kind":"dev","methods":{"activateValidator(address)":{"params":{"_address":"address to be enabled."}},"allowance(address,address)":{"details":"Returns the remaining number of tokens that `spender` will be allowed to spend on behalf of `owner` through {transferFrom}. This is zero by default. This value changes when {approve} or {transferFrom} are called."},"approve(address,uint256)":{"details":"Sets `amount` as the allowance of `spender` over the caller's tokens. Returns a boolean value indicating whether the operation succeeded. IMPORTANT: Beware that changing an allowance with this method brings the risk that someone may use both the old and the new allowance by unfortunate transaction ordering. One possible solution to mitigate this race condition is to first reduce the spender's allowance to 0 and set the desired value afterwards: https://github.com/ethereum/EIPs/issues/20#issuecomment-263524729 Emits an {Approval} event."},"autobond(address,uint256,uint256)":{"details":"Bonds the inflation rewards to the validator's stake at epoch finalization. Restricted to protocol contracts."},"balanceOf(address)":{"details":"Returns the amount of tokens owned by `account`."},"bond(address,uint256)":{"params":{"_amount":"total amount of NTN to bond.","_validator":"address of the validator to delegate stake to."},"returns":{"_0":"uint256 id of the bonding request in the bonding queue"}},"bondFrom(address,address,uint256)":{"params":{"_account":"address of the delegator.","_amount":"total amount of NTN to bond.","_validator":"address of the validator to delegate stake to."},"returns":{"_0":"uint256 id of the bonding request in the bonding queue"}},"changeCommissionRate(address,uint256)":{"params":{"_validator":"address to be enabled. _rate new commission rate, ranging between 0-10000 (10000 = 100%)."}},"getEpochFromBlock(uint256)":{"params":{"_block":"the input block number."}},"getSchedule(address,uint256)":{"params":{"_id":"index of the schedule","_vault":"address of the vault for the schedule"}},"getTotalSchedules(address)":{"params":{"_vault":"address of the vault for the schedules"}},"getUnbondingShare(uint256)":{"params":{"_unbondingID":"id of the unbonding request in unbonding queue"}},"isUnbondingReleased(uint256)":{"params":{"_unbondingID":"id of the unbonding request in unbonding queue"}},"jail(address,uint256,uint8)":{"details":"jails the specified validator","params":{"_jailtime":"the jailing time to be assigned to the validator","_newJailedState":"the validator state to be applied","_nodeAddress":"the node address of the validator to be jailed"},"returns":{"_0":"uint256 the block at which the validator will be released from jail"}},"jailbound(address,uint8)":{"details":"jailbounds the specified validator","params":{"_newJailboundState":"the validator state to be applied","_nodeAddress":"the node address of the validator to be jailbound"}},"pauseValidator(address)":{"details":"emit a {DisabledValidator} event.","params":{"_address":"address to be disabled."}},"registerValidator(string,address,bytes,bytes)":{"details":"Emit a {RegisteredValidator} event.","params":{"_consensusKey":"identifying the bls public key in bytes that the validator node is using.","_enode":"enode identifying the validator node.","_oracleAddress":"identifying the oracle server node that the validator is managing.","_signatures":"is a combination of two ecdsa signatures, and a bls signature as the ownership proof of the validator key appended sequentially. The 1st two ecdsa signatures are in below order: 1. a message containing treasury account and signed by validator account private key . 2. a message containing treasury account and signed by Oracle account private key ."}},"slash(address,uint256)":{"details":"slashes the specified validatorNOTE: 100% slash is not allowed and if attempted will cause a revert","params":{"_nodeAddress":"the node address of the validator to be slashed","_slashingRate":"the rate for the slash"},"returns":{"slashingAmount":"the slashing amount"}},"slashAndJail(address,uint256,uint256,uint8,uint8)":{"details":"slashes and jails the specified validator","params":{"_jailtime":"the jailing time to be assigned to the validator","_newJailboundState":"the validator state to be applied in case of 100% slashing","_newJailedState":"the validator state to be applied for jailing","_nodeAddress":"the node address of the validator to be slashed","_slashingRate":"the rate to be used"},"returns":{"isJailbound":"a flag that signals if the validator has been permanently jailed","jailReleaseBlock":"the block at which the validator will be released from jail","slashingAmount":"the amount slashed in NTN"}},"totalSupply()":{"details":"Returns the amount of tokens in existence."},"transfer(address,uint256)":{"details":"Moves `amount` tokens from the caller's account to `recipient`. Returns a boolean value indicating whether the operation succeeded. Emits a {Transfer} event."},"transferFrom(address,address,uint256)":{"details":"Moves `amount` tokens from `sender` to `recipient` using the allowance mechanism. `amount` is then deducted from the caller's allowance. Returns a boolean value indicating whether the operation succeeded. Emits a {Transfer} event."},"unbond(address,uint256)":{"params":{"_amount":"total amount of LNTN (or NTN if self delegated) to unbond.","_validator":"address of the validator to unbond stake to."},"returns":{"_0":"uint256 id of the unbonding request in the unbonding queue"}},"unbondFrom(address,address,uint256)":{"params":{"_account":"address of the delegator.","_amount":"total amount of LNTN (or NTN if self delegated) to unbond.","_validator":"address of the validator to unbond stake to."},"returns":{"_0":"uint256 id of the unbonding request in the unbonding queue"}},"updateEnode(address,string)":{"params":{"_enode":"new enode to be updated","_nodeAddress":"This identifies the validator you want to update"}}},"version":1},"userdoc":{"events":{"ActivatedValidator(address,address,uint256)":{"notice":"emitted when a validator is activated, validator starts accepting delegation and becomes eligible  for committee inclusion"},"BondingApproval(address,address,uint256)":{"notice":"Emitted when the bonding-allowance (NTN) of a `_caller` for an `_owner` is set by a call to `approveBonding`. `_value` is the new `bondingAllowance` (NTN)."},"BondingRejected(address,address,uint256,uint8)":{"notice":"This event is emitted when a registered bonding request to a validator is rejected"},"CallFailed(address,string,bytes)":{"notice":"This event is emitted when a call to an address fails in a protocol function (like finalize())."},"CommissionRateChange(address,uint256)":{"notice":"Emitted after registering a commission rate change request has been submitted for the validator"},"Eip1559ParamsUpdate((uint256,uint256,uint256,uint256),(uint256,uint256,uint256,uint256))":{"notice":"Event emitted after EIP-1559 parameters are updated"},"EnodeUpdate(address,string,string)":{"notice":"Emitted after updating a enode address of a validator"},"EpochPeriodUpdated(uint256,uint256)":{"notice":"emitted when epoch period is updated"},"NewBondingRequest(address,address,address,bool,uint256,uint256)":{"notice":"This event is emitted when a bonding request to a validator node has been registered. This request will only be effective at the end of the current epoch however the stake will be put in custody immediately from the delegator's account."},"NewEpoch(uint256,uint256,uint256)":{"notice":"emitted when a newEpoch begins"},"NewUnbondingRequest(address,address,address,bool,uint256,uint256)":{"notice":"This event is emitted when an unbonding request to a validator node has been registered. This request will only be effective after the unbonding period, rounded to the next epoch. Please note that because of potential slashing events during this delay period, the released amount may or may not be correspond to the amount requested."},"PausedValidator(address,address,uint256)":{"notice":"emitted when a validator is paused, validator stops accepting delegation and becomes ineligible  for committee inclusion"},"RegisteredValidator(address,address,address,string,address)":{"notice":"emitted when a new validator is registered"},"Rewarded(address,uint256,uint256,uint256,uint256)":{"notice":"emitted when a validator is rewarded for taking part in block consensus  for committee inclusion"}},"kind":"user","methods":{"activateValidator(address)":{"notice":"Re-activate the specified validator."},"approveBonding(address,uint256)":{"notice":"Sets `_amount` as the bonding-allowance (NTN) of `_caller` over the caller's tokens. Returns a boolean value indicating whether the operation succeeded. Emits an {BondingApproval} event."},"bond(address,uint256)":{"notice":"Create a bonding(delegation) request with the caller as delegator."},"bondFrom(address,address,uint256)":{"notice":"Create a bonding(delegation) request with the `_account` as delegator. The caller needs to have required bonding-allowance (NTN) from the `_account`."},"bondingAllowance(address,address)":{"notice":"Returns the remaining number of NTN that `_caller` will be allowed to bond on behalf of `_owner` through `bondFrom`. This is zero by default."},"changeCommissionRate(address,uint256)":{"notice":"Change commission rate for the specified validator."},"circulatingSupply()":{"notice":"Returns the amount of tokens circulating in the network."},"getBlockPeriod()":{"notice":"Returns the block period."},"getBondingRequestByID(uint256)":{"notice":"Returns the bonding request corresponding to bonding ID."},"getClientConfig()":{"notice":"Returns the current client aware config"},"getCommittee()":{"notice":"Returns the block committee."},"getCommitteeEnodes()":{"notice":"Returns the consensus committee enodes."},"getConfig()":{"notice":"Returns the current contract config"},"getCurrentCommitteeSize()":{"notice":"Returns the current size of the consensus committee."},"getCurrentEpochPeriod()":{"notice":"Returns the epoch period of the current epoch"},"getEpochByHeight(uint256)":{"notice":"Returns the epoch info of the height."},"getEpochFromBlock(uint256)":{"notice":"Returns epoch associated to the block number."},"getEpochID()":{"notice":"Returns the current epoch ID"},"getEpochInfo()":{"notice":"Returns the current epoch info of the chain."},"getEpochPeriod()":{"notice":"Returns the epoch period. If there will be an update at epoch end, the new epoch period is returned"},"getEpochTotalBondedStake()":{"notice":"Returns the current epoch total bonded stake"},"getInflationReserve()":{"notice":"Returns the current inflation reserve"},"getLastEpochBlock()":{"notice":"Returns the last epoch's end block height."},"getLastEpochTime()":{"notice":"Returns the last epoch's end block timestamp"},"getLiquidLogicContract()":{"notice":"Returns the liquid logic contract"},"getMaxCommitteeSize()":{"notice":"Returns the maximum size of the consensus committee."},"getMaxScheduleDuration()":{"notice":"Returns the max allowed duration of any schedule or contract."},"getMinimumBaseFee()":{"notice":"Returns the minimum gas price."},"getNextEpochBlock()":{"notice":"Returns the next epoch block."},"getOperator()":{"notice":"Returns the current operator account."},"getOracle()":{"notice":"Returns the current Oracle account."},"getSchedule(address,uint256)":{"notice":"Returns the schedule at index = `_id` in the `vaultSchedules[_vault]` array."},"getTotalSchedules(address)":{"notice":"Returns total number of schedules for the vault at address `_vault`."},"getTreasuryAccount()":{"notice":"Returns the current treasury account."},"getTreasuryFee()":{"notice":"Returns the current treasury fee."},"getUnbondingPeriod()":{"notice":"Returns the un-bonding period."},"getUnbondingRequestByID(uint256)":{"notice":"Returns the unbonding request corresponding to unbonding ID."},"getUnbondingShare(uint256)":{"notice":"Returns the unbonding share after the unbonding request is applied at epoch end."},"getValidator(address)":{"notice":"Returns the validator object associated with `_addr`."},"getValidatorState(address)":{"notice":"Returns the state of the validator associated with `_addr`."},"getValidators()":{"notice":"Returns the current list of validators."},"getVersion()":{"notice":"Returns the current contract version."},"isUnbondingReleased(uint256)":{"notice":"Returns `true` if unbonding is released and `false` otherwise."},"pauseValidator(address)":{"notice":"Pause the validator and stop it accepting delegations."},"registerValidator(string,address,bytes,bytes)":{"notice":"Register a new validator in the system.  The validator might be selected to be part of consensus. This validator will have assigned to its treasury account the caller of this function. A new token \"Liquid Stake\" is deployed at this phase."},"unbond(address,uint256)":{"notice":"Create an unbonding request with the caller as delegator."},"unbondFrom(address,address,uint256)":{"notice":"Create an unbonding request with the `_account` as delegator. The caller needs to have required unbonding-allowance to unbond LNTN from the `_account`."},"updateEnode(address,string)":{"notice":"Update enode of a registered validator. This function updates the network connection information (IP or/and port) of a registered validator. you cannot change the validator's address (pubkey part of the enode)"}},"version":1}},"settings":{"compilationTarget":{"autonity/solidity/contracts/interfaces/IAutonity.sol":"IAutonity"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":10000},"remappings":[]},"sources":{"autonity/solidity/contracts/asm/interfaces/IACU.sol":{"keccak256":"0x47447b2dbf52f606809fcc61e3dbff27ca373418de47a11325ad56d3ba9d257d","license":"LGPL-3.0-only","urls":["bzz-raw://4cdf9597dfab62e9550a34e2b8b9127f25135b8f2ef382b781ab74913ce38f14","dweb:/ipfs/QmeEcPMtr9SUiubQ8fXtSJGpirhpdMj5bbreYE4zixU3eh"]},"autonity/solidity/contracts/asm/interfaces/IAuctioneer.sol":{"keccak256":"0x55a6241b428215804bcb5ab564e16ed17a4b621f9be005be2b8b4ef69122f7bf","license":"LGPL-3.0-only","urls":["bzz-raw://8b4e34515e537f2bdd369a4ffeb47503d5db836cf92dc6616fd442bffd873b5d","dweb:/ipfs/QmYGZKY1rJ2jDdUqypfLSYkeGTyZFsHDJ5nvU2m6sTCqZo"]},"autonity/solidity/contracts/asm/interfaces/IStabilization.sol":{"keccak256":"0x5abab89e757b7dd037ddd2db6d6d046eb7bc09ca704e0d3a0f1a7b3e77a6e485","license":"LGPL-3.0-only","urls":["bzz-raw://ad6639df1565805d8c04ce678b02e642a1eb5c4f64f96231aa4007355abaf4a1","dweb:/ipfs/QmTSZ7xnH8XDwY9fhbYou7bgY5hj1V6owTGyYMoP8u2d4t"]},"autonity/solidity/contracts/asm/interfaces/ISupplyControl.sol":{"keccak256":"0x7b63460a36ee68199e0d7c7f8e8cc22f1fe00ae12a244da1def2349752fb7b83","license":"LGPL-3.0-only","urls":["bzz-raw://058f2a5896a799c71faf3ffb0c65e6e12787de337161b888d3fe7e7239621e0e","dweb:/ipfs/QmUdB431CZgcK8W6qvnRScyRahLeFFYDhZuVLdfV9jSWQ7"]},"autonity/solidity/contracts/interfaces/IAccountability.sol":{"keccak256":"0x93ae687bdc50d8a72b62711f737768c6747056ec2656b6f71feb10d3844f48bf","license":"LGPL-3.0-only","urls":["bzz-raw://058714040b67adfc3fbd77f16251805af3029d8f5b2200d58f1d21135b6a89b4","dweb:/ipfs/QmcpCpXhzdYw27Cb9mkLiUDnS3VzPdsC2rUeBDNGR1MqrM"]},"autonity/solidity/contracts/interface